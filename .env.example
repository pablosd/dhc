# Formulario de estimado (docs/02 → Formulario). Copiar a .env.local.
# Web3Forms: crear la clave en https://web3forms.com con el correo que recibe
# los pedidos (cuestionario I2). La clave es pública por diseño.
NEXT_PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Analítica: Umami autoalojado (docs/02 → Analítica). Vacío = no se carga.
# El ID se crea en el panel de Umami al dar de alta el sitio.
NEXT_PUBLIC_UMAMI_SRC=https://stats.psalazar.dev/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=dhc.psalazar.dev
